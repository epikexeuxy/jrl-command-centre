# ---- JRL Command Centre — environment template ----
# Copy to .env (docker compose reads it automatically) and change every secret.

# Security (REQUIRED: generate a long random value, e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Docker compose default (postgres service):
DATABASE_URL=postgresql+psycopg://jrl:jrl@postgres:5432/jrl
# Local dev without docker: sqlite:///./jrl_dev.db

# Cache / rate limiting (falls back to in-memory if unset or unreachable)
REDIS_URL=redis://redis:6379/0

# Bootstrap admin (created by `python -m app.db.seed`; change the password immediately)
ADMIN_EMAIL=admin@jrladdha.com
ADMIN_PASSWORD=JrlAdmin@2026

# Demo data (client DEMO001 with live-NAV holdings). Set false for a clean install.
SEED_DEMO_DATA=true

# Analytics
RISK_FREE_RATE=0.065

# CORS (comma-separated origins for the browser app)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Phase 3 (DealDesk AI briefs) — leave empty until then
ANTHROPIC_API_KEY=
